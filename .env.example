# Copy to .env and edit. No source enabled by default requires a key.
# The server reads these at startup; never commit .env.

# Port for the local server (default 5177)
PORT=5177

# Bind address. Keep 127.0.0.1 unless you deliberately want LAN access (e.g. from your phone).
HOST=127.0.0.1

# Optional: HTTP User-Agent sent to data sources (identify yourself politely)
FFTA_USER_AGENT=FantasyFootballTradeAnalyzer/1.0 (personal use)

# Optional: request timeout in ms for source fetches
FFTA_FETCH_TIMEOUT_MS=45000

# Reserved for future optional adapters (not used by default):
# FANTASYPROS_API_KEY=
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
